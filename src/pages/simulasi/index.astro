---
import Base from '@layouts/Base.astro';
import Icon from '@components/ui/Icon.tsx';
---
<Base title="Simulasi — TN Trainer">
  <div class="mx-auto max-w-5xl px-4 py-8">
    <header class="mb-6">
      <a href="/" class="mb-3 inline-flex items-center gap-1 text-xs font-medium text-slate-500 hover:text-slate-700">
        <Icon name="left" class="h-3.5 w-3.5" /> Beranda
      </a>
      <h1 class="text-2xl font-bold text-slate-900">Mode Simulasi</h1>
      <p class="mt-1 max-w-2xl text-sm text-slate-600">
        Uji stamina dan manajemen waktu. Timer tidak bisa dijeda. Jawaban tersimpan otomatis —
        reload di tengah sesi akan memulihkan posisi dan sisa waktu.
      </p>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
      <a href="/simulasi/padat-105" class="card group transition hover:border-tn-300 hover:shadow-md">
        <div class="flex items-center justify-between">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-tn-50 text-tn-600">
            <Icon name="target" class="h-5 w-5" />
          </span>
          <span class="rounded-full bg-tn-50 px-2.5 py-1 text-xs font-semibold text-tn-700">105 menit</span>
        </div>
        <h2 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-tn-700">Padat 105</h2>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">
          Empat mapel berurutan seperti hari ujian sebenarnya. Checkpoint pada menit 35, 65, 85, dan 105.
        </p>
        <table class="mt-3 w-full text-xs">
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-1.5">Matematika</td><td class="py-1.5 text-right tabular-nums">35 mnt · 30 soal</td></tr>
            <tr class="border-b border-slate-100"><td class="py-1.5">IPA</td><td class="py-1.5 text-right tabular-nums">30 mnt · 40 soal</td></tr>
            <tr class="border-b border-slate-100"><td class="py-1.5">B. Indonesia</td><td class="py-1.5 text-right tabular-nums">20 mnt · 40 soal</td></tr>
            <tr><td class="py-1.5">B. Inggris</td><td class="py-1.5 text-right tabular-nums">20 mnt · 35 soal</td></tr>
          </tbody>
        </table>
      </a>

      <a href="/simulasi/longgar-90" class="card group transition hover:border-tn-300 hover:shadow-md">
        <div class="flex items-center justify-between">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
            <Icon name="clock" class="h-5 w-5" />
          </span>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">90 menit</span>
        </div>
        <h2 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-tn-700">Longgar 90</h2>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">
          Satu mapel selama 90 menit. Cocok untuk latihan stamina satu bidang sebelum mencoba format padat.
        </p>
        <ul class="mt-3 space-y-1 text-xs text-slate-600">
          <li>· Pilih satu dari empat mapel</li>
          <li>· Jumlah butir mengikuti target pace mapel</li>
          <li>· Skor 1/0/0 tanpa penalti</li>
        </ul>
      </a>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs text-slate-600">
      <p class="font-semibold text-slate-700">Mode debug</p>
      <p class="mt-0.5">
        Untuk menguji checkpoint tanpa menunggu 105 menit, buka
        <code class="rounded bg-slate-100 px-1">/simulasi/padat-105?debug=1</code> — setiap blok menjadi
        30 detik. Jangan pakai untuk latihan sungguhan.
      </p>
    </div>
  </div>
</Base>
