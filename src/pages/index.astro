---
import Base from '@layouts/Base.astro';
import HomeStats from '@components/home/HomeStats.tsx';
import Icon from '@components/ui/Icon.tsx';

const paket = [
  { id: 'paket-1', nama: 'Fondasi Naskah 2018', ket: '6 butir naskah asli · 6 prediksi', menit: 10, warna: 'emerald' },
  { id: 'paket-2', nama: 'Seleksi Campuran', ket: '3 butir naskah · 9 prediksi', menit: 11, warna: 'tn' },
  { id: 'paket-3', nama: 'Simulasi HOTS', ket: '2 butir naskah · 10 prediksi tersulit', menit: 11, warna: 'indigo' },
  { id: 'paket-4', nama: 'Uji Coba Baru', ket: '12 butir baru tanpa naskah', menit: 10, warna: 'rose' },
];
---
<Base title="TN Trainer — Latihan Seleksi Akademik Taruna Nusantara">
  <!-- HERO -->
  <section class="border-b border-slate-200 bg-white/60">
    <div class="container-page py-10 lg:py-14">
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <div>
          <span class="chip-brand">
            <Icon name="spark" class="h-3.5 w-3.5" /> Latihan lokal · tanpa login · tanpa backend
          </span>
          <h1 class="mt-4 text-balance text-3xl font-bold leading-[1.15] tracking-tight text-slate-900 lg:text-[2.6rem]">
            Paham soalnya.<br />
            <span class="text-tn-600">Jawab lebih cepat.</span>
          </h1>
          <p class="mt-4 max-w-xl text-[0.98rem] leading-relaxed text-slate-600">
            Empat puluh delapan soal seleksi akademik Taruna Nusantara dalam tiga paket terpisah, empat mode
            latihan, dan pengukuran waktu per butir. Semua berjalan di laptop ini — tidak perlu akun.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a href="/paket" class="btn-primary btn-lg">
              <Icon name="play" class="h-4 w-4" /> Pilih paket soal
            </a>
            <a href="/simulasi/padat-105" class="btn-secondary btn-lg">
              <Icon name="clock" class="h-4 w-4" /> Simulasi 105 menit
            </a>
          </div>

          <dl class="mt-7 grid max-w-lg grid-cols-3 gap-3 text-sm">
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-2.5">
              <dt class="text-[0.65rem] font-semibold uppercase tracking-wide text-slate-400">Bank</dt>
              <dd class="mt-0.5 text-lg font-bold tabular-nums text-slate-900">48 butir</dd>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-2.5">
              <dt class="text-[0.65rem] font-semibold uppercase tracking-wide text-slate-400">Paket</dt>
              <dd class="mt-0.5 text-lg font-bold tabular-nums text-slate-900">4 terpisah</dd>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-2.5">
              <dt class="text-[0.65rem] font-semibold uppercase tracking-wide text-slate-400">Naskah asli</dt>
              <dd class="mt-0.5 text-lg font-bold tabular-nums text-slate-900">11 butir</dd>
            </div>
          </dl>

          <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
            <kbd>A</kbd>–<kbd>E</kbd> menjawab
            <span class="text-slate-300">·</span>
            <kbd>←</kbd><kbd>→</kbd> pindah
            <span class="text-slate-300">·</span>
            <kbd>F</kbd> ragu
            <span class="text-slate-300">·</span>
            <kbd>Enter</kbd> lanjut
          </p>
        </div>

        <aside class="card-tint">
          <div class="flex items-center justify-between">
            <p class="eyebrow">Isi bank saat ini</p>
            <a href="/bank" class="text-xs font-semibold text-tn-700 hover:underline">Kelola</a>
          </div>
          <div class="mt-3">
            <HomeStats client:load />
          </div>
          <div class="mt-4 rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-xs leading-relaxed text-slate-600">
            <p class="font-semibold text-slate-800">Bank bisa diganti tanpa build</p>
            <p class="mt-0.5">
              Ganti JSON di <code class="rounded bg-slate-100 px-1 py-0.5 text-[0.7rem]">public/bank/</code>, lalu tekan
              <strong class="font-semibold"> Muat ulang</strong> di halaman Bank.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- TIGA PAKET -->
  <section class="container-page py-10">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="section-title">Empat paket, empat tingkat kesulitan</h2>
        <p class="section-sub">Dikerjakan berurutan sebagai pemanasan, lalu naik ke butir HOTS. Tiap paket punya sesi dan timer sendiri.</p>
      </div>
      <a href="/paket" class="btn-ghost btn-sm">
        Lihat semua <Icon name="right" class="h-3.5 w-3.5" />
      </a>
    </div>

    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {paket.map((p, i) => (
        <a href={`/paket/${p.id}`} class="card card-hover group flex items-center gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-tn-50 text-base font-bold text-tn-700">
            {i + 1}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-bold text-slate-900 group-hover:text-tn-700">{p.nama}</span>
            <span class="mt-0.5 block text-xs text-slate-500">{p.ket}</span>
          </span>
          <span class="shrink-0 text-right">
            <span class="block text-sm font-bold tabular-nums text-slate-900">±{p.menit}m</span>
            <span class="block text-[0.65rem] uppercase tracking-wide text-slate-400">12 butir</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- MODE -->
  <section class="border-y border-slate-200 bg-white/60">
    <div class="container-page py-10">
      <h2 class="section-title">Empat cara berlatih</h2>
      <p class="section-sub">Pilih sesuai fase persiapan. Semua mode menyimpan progres di perangkat ini.</p>

      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/paket" class="card card-hover group">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-tn-50 text-tn-600">
            <Icon name="list" class="h-5 w-5" />
          </span>
          <h3 class="mt-3 text-base font-bold text-slate-900 group-hover:text-tn-700">Paket soal</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">Tiga set siap pakai, campuran naskah asli dan prediksi HOTS.</p>
          <p class="mt-3 text-xs font-semibold text-tn-700">12 butir · bertimer</p>
        </a>

        <a href="/belajar" class="card card-hover group">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
            <Icon name="book" class="h-5 w-5" />
          </span>
          <h3 class="mt-3 text-base font-bold text-slate-900 group-hover:text-tn-700">Mode belajar</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">Umpan balik instan dan pembahasan tiga lapis: inti, langkah, jebakan.</p>
          <p class="mt-3 text-xs font-semibold text-emerald-700">tanpa timer</p>
        </a>

        <a href="/cepat" class="card card-hover group">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
            <Icon name="zap" class="h-5 w-5" />
          </span>
          <h3 class="mt-3 text-base font-bold text-slate-900 group-hover:text-tn-700">Mode cepat</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">Countdown per butir sesuai target pace. Streak benar menambah waktu.</p>
          <p class="mt-3 text-xs font-semibold text-amber-700">Math 70 · IPA 45 · BIN 30 · BIG 34 dtk</p>
        </a>

        <a href="/simulasi" class="card card-hover group">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
            <Icon name="clock" class="h-5 w-5" />
          </span>
          <h3 class="mt-3 text-base font-bold text-slate-900 group-hover:text-tn-700">Simulasi</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">Empat mapel berurutan dengan checkpoint, atau satu mapel 90 menit.</p>
          <p class="mt-3 text-xs font-semibold text-indigo-700">105 menit · 4 blok</p>
        </a>
      </div>
    </div>
  </section>

  <!-- YANG DIUKUR + SUMBER -->
  <section class="container-page py-10">
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div class="card">
        <h2 class="text-sm font-bold text-slate-900">Yang diukur setiap sesi</h2>
        <ul class="mt-3 space-y-3 text-sm">
          <li class="flex gap-3">
            <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-tn-50 text-tn-600"><Icon name="target" class="h-4 w-4" /></span>
            <span><strong class="font-semibold text-slate-800">Akurasi per kategori</strong><span class="block text-xs text-slate-500">Status Lemah di bawah 60%, Kuat di atas 85%.</span></span>
          </li>
          <li class="flex gap-3">
            <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600"><Icon name="zap" class="h-4 w-4" /></span>
            <span><strong class="font-semibold text-slate-800">Kecepatan: median, p75, ketepatan waktu</strong><span class="block text-xs text-slate-500">Indeks kecepatan membandingkan target pace dengan waktu nyata.</span></span>
          </li>
          <li class="flex gap-3">
            <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600"><Icon name="chart" class="h-4 w-4" /></span>
            <span><strong class="font-semibold text-slate-800">Riwayat sesi</strong><span class="block text-xs text-slate-500">Tersimpan lokal, bisa dicetak dari halaman hasil.</span></span>
          </li>
        </ul>
      </div>

      <div class="card-soft">
        <p class="eyebrow">Soal mana yang asli</p>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          <strong class="font-semibold text-slate-900">11 butir</strong> diambil dari
          <em>Salinan Soal Seleksi Akademik Calon Siswa SMA Taruna Nusantara 2018 — Matematika</em> dan menyimpan nomor butir aslinya.
          <strong class="font-semibold text-slate-900">37 butir</strong> adalah prediksi yang disusun dari kisi-kisi resmi CBT TN37, bukan soal panitia.
        </p>
        <p class="mt-3 text-xs leading-relaxed text-slate-500">
          Naskah seleksi 2021–2026 tidak diterbitkan panitia dan tidak beredar, jadi tidak ada butir yang diklaim berasal dari tahun tersebut.
        </p>
        <a href="/paket" class="btn-secondary btn-sm mt-4">
          <Icon name="download" class="h-3.5 w-3.5" /> Lihat rincian sumber per butir
        </a>
      </div>
    </div>
  </section>
</Base>
