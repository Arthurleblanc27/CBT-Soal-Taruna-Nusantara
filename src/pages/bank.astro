---
import Base from '@layouts/Base.astro';
import BankManager from '@components/bank/BankManager.tsx';
---
<Base title="Bank soal — TN Trainer">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <header class="mb-5">
      <a href="/" class="mb-3 inline-flex items-center gap-1 text-xs font-medium text-slate-500 hover:text-slate-700">
        ← Beranda
      </a>
      <h1 class="text-2xl font-bold text-slate-900">Bank soal</h1>
      <p class="mt-1 max-w-2xl text-sm text-slate-600">
        Bank dibaca saat runtime dari <code class="rounded bg-slate-100 px-1">public/bank/</code>.
        Ganti satu file JSON lalu tekan <strong>Muat ulang</strong> — soal baru langsung aktif tanpa build.
        Impor JSON dari disk juga didukung dan tersimpan lokal.
      </p>
    </header>
    <BankManager client:only="preact" />
  </div>
</Base>
